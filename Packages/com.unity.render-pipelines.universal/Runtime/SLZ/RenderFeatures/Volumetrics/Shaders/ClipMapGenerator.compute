

////This generates a combined clipmap so we don't have to sample every volume map every frame////
//TODO: Add cascades or tapper
#pragma use_dxc
#pragma only_renderers vulkan d3d11

#pragma kernel ClipMapGen
#pragma kernel ClipMapClear
#pragma kernel ClipMapHeight

RWTexture3D<float4> Clipmap;

SamplerState my_point_clamp_sampler;

float3 ClipmapWorldPosition;
float  ClipmapScale;

float3	VolumeWorldSize; 
float3	VolumeWorldPosition;

Texture3D<float4> _VolumeMap0;
Texture3D<float4> _VolumeMap1;
Texture3D<float4> _VolumeMap2;
Texture3D<float4> _VolumeMap3;
Texture3D<float4> _VolumeMap4;
Texture3D<float4> _VolumeMap5;
Texture3D<float4> _VolumeMap6;
Texture3D<float4> _VolumeMap7;

SamplerState linear_clamp_sampler;
float VolumeDensity;

shared float _GlobalExtinction;
float4 clearColor;

cbuffer clipmapGenConstants
{
    // world-space position of the last clipmap's minimum bound, and the resolution of the clipmap (clipmap is assumed to have equal x,y, and z dimensions) 
    float4 oldClipMin_ClipResolution;
    // world-space position of the current clipmap's minimum bound, and the worldspace width of the clipmap (clipmap is assumed to be cubic)
    float4 newClipMin_ClipSize;
};

#define OLD_CLIP_MIN	oldClipMin_ClipResolution.xyz
#define CLIP_MIN		newClipMin_ClipSize.xyz
#define CLIP_RESOLUTION oldClipMin_ClipResolution.w
#define CLIP_DIMENSIONS newClipMin_ClipSize.w

cbuffer clipmapGenPerVolume
{
	int4 volumeCount_clearTexture;
    float4 volBoundsMin_MipLevel[8];
    float4 rcpVolBoundsSize[8];
}

#define VOLUME_COUNT volumeCount_clearTexture.x
#define CLEAR_TEXTURE volumeCount_clearTexture.y


[numthreads(4, 4, 4)]
void ClipMapClear(uint3 id : SV_DispatchThreadID)
{
	Clipmap[id.xyz] = float4(0, 0, 0, 0);
}

void SampleVolume(inout float4 result, inout bool hasSampled, float3 wPos, int volumeIdx, Texture3D<float4> volume)
{
	float3 volCoords = (wPos - volBoundsMin_MipLevel[volumeIdx].xyz) * rcpVolBoundsSize[volumeIdx].xyz;
	if (all(volCoords > 0.0) && all(volCoords < 1.0))
	{
		float3 volumeSample = volume.SampleLevel(linear_clamp_sampler, volCoords, volBoundsMin_MipLevel[volumeIdx].w);
		result.rgb = max(volumeSample, result.rgb);
		hasSampled = true;
	}
}

[numthreads(8,8,1)]
void ClipMapGen (uint3 id : SV_DispatchThreadID)
{
    //uint count, stride;
    if (any(id >= ((uint) CLIP_RESOLUTION)) )
    {
        return;
    }
    
    float3 clipmapPos = ((float3)id.xyz + 0.5f) / CLIP_RESOLUTION;
	float3 wPos = CLIP_DIMENSIONS * clipmapPos + (CLIP_MIN).xyz;
    
	float3 oldBoundsMax = OLD_CLIP_MIN + float3(CLIP_DIMENSIONS, CLIP_DIMENSIONS, CLIP_DIMENSIONS);
    
	if (all(wPos > OLD_CLIP_MIN) && all(wPos < oldBoundsMax))
    {
        return;
    }
    

	float4 result = float4(0, 0, 0, 0);
	bool hasSampled = CLEAR_TEXTURE == 1; // Always write to the output if we're clearing

	// Cant have an array of textures, so I have to manually unroll the loop
	{
		SampleVolume(result, hasSampled, wPos, 0, _VolumeMap0);
	}
	if (VOLUME_COUNT > 1)
	{
		SampleVolume(result, hasSampled, wPos, 1, _VolumeMap1);
	}
	if (VOLUME_COUNT > 2)
	{
		SampleVolume(result, hasSampled, wPos, 2, _VolumeMap2);
	}
	if (VOLUME_COUNT > 3)
	{
		SampleVolume(result, hasSampled, wPos, 3, _VolumeMap3);
	}
	if (VOLUME_COUNT > 4)
	{
		SampleVolume(result, hasSampled, wPos, 4, _VolumeMap4);
	}
	if (VOLUME_COUNT > 5)
	{
		SampleVolume(result, hasSampled, wPos, 5, _VolumeMap5);
	}
	if (VOLUME_COUNT > 6)
	{
		SampleVolume(result, hasSampled, wPos, 6, _VolumeMap6);
	}
	if (VOLUME_COUNT > 7)
	{
		SampleVolume(result, hasSampled, wPos, 7, _VolumeMap7);
	}
    
    // only bother loading the previous result if we actually sampled at least one of the volumes
	if (CLEAR_TEXTURE == 0 && hasSampled)
	{
		result = max(result, Clipmap[id.xyz]);
	}
    
	if (hasSampled)
	{
		Clipmap[id.xyz] = result;
	}
}

[numthreads(4, 4, 4)]
void MediapGen(uint3 id : SV_DispatchThreadID)
{

}

[numthreads(4, 4, 4)]
void ClipMapHeight(uint3 id : SV_DispatchThreadID)
{
    //uint count, stride;

    float4 UVW = float4(0,0,0,0);
	Clipmap.GetDimensions(UVW.x, UVW.y, UVW.z);

    UVW.xyz = (id + 0.5) / UVW.xyz; //0-1 scaling
    UVW.w = 1;

    float4 WorldCoord = UVW * ClipmapScale + ClipmapWorldPosition.xyzz;

    //float heightDens = WorldCoord.y > 0 ? 0:1;

    float heightDens = _GlobalExtinction;

	Clipmap[id.xyz] = max(Clipmap[id.xyz].rgba, float4(0, 0, 0, heightDens));
;
}